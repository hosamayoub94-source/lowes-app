async function renderCal(){
  const grid=document.getElementById("cal-grid");const lbl=document.getElementById("cal-label");if(!grid)return;
  lbl.textContent=MONTHS_AR[calM]+" "+calY;
  const mStr=`${calY}/${pad(calM+1)}`;
  const{data}=await sb.from("attendance").select("date,status,time_in,time_out").like("date",mStr+"%");
  const map={};(data||[]).forEach(r=>{const d=parseInt(r.date.split("/")[2]);if(!map[d])map[d]=[];map[d].push(r);});
  const dn=["ح","ن","ث","ر","خ","ج","س"];const first=new Date(calY,calM,1).getDay();const dim=new Date(calY,calM+1,0).getDate();const today=new Date();
  let html=dn.map(d=>`<div class="cal-hdr">${d}</div>`).join("");
  for(let i=0;i<first;i++)html+="<div class='cal-day empty'></div>";
  let tp=0,ta=0,tv=0,tm=0;
  for(let d=1;d<=dim;d++){
    const recs=map[d]||[];const isT=d===today.getDate()&&calM===today.getMonth()&&calY===today.getFullYear();
    let cls="cal-day"+(isT?" today":"");
    if(recs.some(r=>r.status===TL.in)){cls+=" present";tp++;}else if(recs.some(r=>r.status===TL.abs)){cls+=" absent";ta++;}else if(recs.some(r=>r.status===TL.vac)){cls+=" vacation";tv++;}
    recs.forEach(r=>tm+=calcH(r.time_in,r.time_out));
    html+=`<div class="${cls}"><span>${d}</span></div>`;
  }
  grid.innerHTML=html;setEl("cal-p",tp);setEl("cal-a",ta);setEl("cal-v",tv);setEl("cal-h",tm.toFixed(1)+"h");
}
function calPrev(){calM--;if(calM<0){calM=11;calY--;}renderCal();}function calNext(){calM++;if(calM>11){calM=0;calY++;}renderCal();}

