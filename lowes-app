function calcT(en){
  const g=id=>{const e=document.getElementById(id+"_"+en);return parseFloat(e?.value||0)||0};
  const gs=id=>{const e=document.getElementById(id+"_"+en);return e?.value||"percentage"};
  const base=g("base"),sales=g("sales"),oth=g("oth"),ota=g("ota"),sct=gs("sct"),scv=g("scv"),tgt=g("tgt"),tct=gs("tct"),tcv=g("tcv"),alw=g("alw"),ded=g("ded");
  const ot=oth*ota;const sc=sct==="percentage"?sales*(scv/100):scv;const ta=sales>=tgt&&tgt>0;const tc=ta?(tct==="percentage"?sales*(tcv/100):tcv):0;
  const bon=document.getElementById("bon_"+en);let bt=0;bon?.querySelectorAll(".bonus-item").forEach(item=>{const ins=item.querySelectorAll("input");bt+=parseFloat(ins[1]?.value||0)||0;});
  const total=Math.max(0,base+ot+sc+tc+alw+bt-ded);const fmt=n=>n.toLocaleString()+" ل.س";setEl("tot_"+en,fmt(total));setEl("tot2_"+en,fmt(total));
}
function addBon(en){const c=document.getElementById("bon_"+en);const d=document.createElement("div");d.className="bonus-item";d.innerHTML=`<input type="text" placeholder="اسم الإضافة" oninput="calcT('${en}')"><input type="number" placeholder="المبلغ" oninput="calcT('${en}')"><button class="bonus-remove" onclick="this.parentElement.remove();calcT('${en}')">✕</button>`;c.appendChild(d);}
