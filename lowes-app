function exportPayExcel(){
  const month=document.getElementById("pay-month")?.value||currMonth();
  const rows=[["الموظف","القسم","الراتب الأساسي","الإضافي","عمولة مبيعات","عمولة تارگت","إضافات مخصصة","البدلات","خصومات","الإجمالي"]];
  allEmps.forEach(emp=>{const p=window._payMap?.[emp.name]||{};const bt=(p.custom_bonuses||[]).reduce((s,b)=>s+parseFloat(b.amount||0),0);rows.push([emp.name,emp.team,p.base_salary||0,p.overtime_amount||0,p.sales_commission||0,p.target_commission||0,bt,p.internet_allowance||0,p.deductions||0,p.total_salary||0]);});
  const ws=XLSX.utils.aoa_to_sheet(rows);const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,"رواتب "+month);XLSX.writeFile(wb,`رواتب_${month.replace("/","_")}.xlsx`);
}

let repData=[];
async function loadReport(){
  const month=document.getElementById("rep-month")?.value||currMonth();const team=document.getElementById("rep-team")?.value||"";
  let q=sb.from("attendance").select("*").like("date",month+"%");if(team)q=q.eq("team",team);
  const{data}=await q;const recs=data||[];const empMap={};
  recs.forEach(r=>{if(!empMap[r.employee_name])empMap[r.employee_name]={name:r.employee_name,team:r.team,present:0,absent:0,vacation:0,hours:0};const e=empMap[r.employee_name];if(r.status===TL.in)e.present++;else if(r.status===TL.abs)e.absent++;else if(r.status===TL.vac)e.vacation++;e.hours+=calcH(r.time_in,r.time_out);});
  repData=Object.values(empMap);renderReport();
  setEl("rep-p",repData.reduce((s,e)=>s+e.present,0));setEl("rep-a",repData.reduce((s,e)=>s+e.absent,0));setEl("rep-h",repData.reduce((s,e)=>s+e.hours,0).toFixed(1)+"h");setEl("rep-e",repData.length);
}
function renderReport(){
  const search=document.getElementById("rep-search")?.value?.toLowerCase()||"";let filtered=repData;if(search)filtered=filtered.filter(e=>e.name.toLowerCase().includes(search));
  const el=document.getElementById("rep-content");if(!el)return;
  if(!filtered.length){el.innerHTML="<div class='empty'><div class='ei'>📭</div><p>لا يوجد بيانات</p></div>";return}
  el.innerHTML=`<div class="tbl-scroll"><div class="tbl-wrap"><table><thead><tr><th>الموظف</th><th>القسم</th><th>حضور</th><th>غياب</th><th>إجازة</th><th>ساعات</th><th>متوسط</th><th>نسبة</th></tr></thead><tbody>
  ${filtered.map((e,i)=>{const pct=e.present+e.absent>0?Math.round(e.present/(e.present+e.absent)*100):0;return`<tr><td><div style="width:26px;height:26px;border-radius:50%;background:${COLORS[i%COLORS.length]};color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;margin-left:5px;vertical-align:middle">${initials(e.name)}</div>${e.name}</td><td><span class="badge b-vac">${e.team}</span></td><td style="color:var(--green);font-weight:700">${e.present}</td><td style="color:var(--red);font-weight:700">${e.absent}</td><td style="color:var(--blue)">${e.vacation}</td><td style="font-weight:700">${e.hours.toFixed(1)}h</td><td>${e.present>0?(e.hours/e.present).toFixed(1):0}h</td><td><span class="badge ${pct>=90?"b-in":pct>=70?"b-abs":"b-out"}">${pct}%</span></td></tr>`;}).join("")}
  </tbody></table></div></div>`;
}
function exportRepExcel(){
  const month=document.getElementById("rep-month")?.value||currMonth();
  const rows=[["الموظف","القسم","حضور","غياب","إجازة","ساعات","متوسط/يوم","نسبة%"]];
  repData.forEach(e=>{const pct=e.present+e.absent>0?Math.round(e.present/(e.present+e.absent)*100):0;rows.push([e.name,e.team,e.present,e.absent,e.vacation,e.hours.toFixed(1),e.present>0?(e.hours/e.present).toFixed(1):0,pct+"%"]);});
  const ws=XLSX.utils.aoa_to_sheet(rows);const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,"تقرير "+month);XLSX.writeFile(wb,`تقرير_${month.replace("/","_")}.xlsx`);
}

function fillSalSel(){
  const sel=document.getElementById("sal-emp");if(!sel)return;sel.innerHTML="<option value=''>اختر الموظف</option>";
  allEmps.forEach(e=>{const o=document.createElement("option");o.value=e.name;o.textContent=e.name;sel.appendChild(o);});
}
async function loadSalSet(empName){
  const f=document.getElementById("sal-fields");if(!empName){f.style.display="none";return}f.style.display="block";
  const{data}=await sb.from("salaries").select("*").eq("employee_name",empName).limit(1);const s=data&&data.length?data[0]:{};
  const el=id=>document.getElementById(id);
  if(el("sl-base"))el("sl-base").value=s.base_salary||"";if(el("sl-net"))el("sl-net").value=s.internet_allowance||"";if(el("sl-food"))el("sl-food").value=s.food_allowance||"";if(el("sl-target"))el("sl-target").value=s.monthly_target||"";
  if(el("sl-tc-type"))el("sl-tc-type").value=s.target_commission_type||"percentage";if(el("sl-tc-val"))el("sl-tc-val").value=s.target_commission_value||"";
  if(el("sl-sc-type"))el("sl-sc-type").value=s.sales_commission_type||"percentage";if(el("sl-sc-val"))el("sl-sc-val").value=s.sales_commission_value||"";
}
async function saveSalSet(){
  const empName=document.getElementById("sal-emp").value;if(!empName)return;const msg=document.getElementById("sal-msg");msg.style.color="var(--muted)";msg.textContent="جاري الحفظ...";
  const g=id=>{const e=document.getElementById(id);return parseFloat(e?.value||0)||0};const gs=id=>{const e=document.getElementById(id);return e?.value||"percentage"};
  const payload={employee_name:empName,base_salary:g("sl-base"),internet_allowance:g("sl-net"),food_allowance:g("sl-food"),monthly_target:g("sl-target"),target_commission_type:gs("sl-tc-type"),target_commission_value:g("sl-tc-val"),sales_commission_type:gs("sl-sc-type"),sales_commission_value:g("sl-sc-val"),updated_at:new Date().toISOString()};
  const{data:ex}=await sb.from("salaries").select("id").eq("employee_name",empName).limit(1);let error;
  if(ex&&ex.length)({error}=await sb.from("salaries").update(payload).eq("employee_name",empName));else({error}=await sb.from("salaries").insert(payload));
  if(error){msg.style.color="var(--rtxt)";msg.textContent="❌ خطأ";}else{msg.style.color="var(--gtxt)";msg.textContent="✅ تم!";setTimeout(()=>msg.textContent="",3000);}
}

async function changePass(r2){
  const curId=r2==="manager"?"cur-mgr-p":"cur-adm-p";const newId=r2==="manager"?"new-mgr-p":"new-adm-p";const msgId=r2==="manager"?"mgr-pass-msg":"adm-pass-msg";const key=r2==="manager"?"manager_pass":"admin_pass";
  const cur=document.getElementById(curId)?.value;const newP=document.getElementById(newId)?.value;const msg=document.getElementById(msgId);
  if(cur!==admPasses[r2]){msg.style.color="var(--rtxt)";msg.textContent="❌ كلمة السر الحالية غلط";return}
  if(!newP||newP.length<6){msg.style.color="var(--rtxt)";msg.textContent="⚠️ لازم 6 أحرف على الأقل";return}
  msg.style.color="var(--muted)";msg.textContent="جاري الحفظ...";
  const{error}=await sb.from("system_settings").update({value:newP,updated_at:new Date().toISOString()}).eq("key",key);
  if(error){msg.style.color="var(--rtxt)";msg.textContent="❌ خطأ";}else{admPasses[r2]=newP;msg.style.color="var(--gtxt)";msg.textContent="✅ تم تغيير كلمة السر!";document.getElementById(curId).value="";document.getElementById(newId).value="";setTimeout(()=>msg.textContent="",3000);}
}

async function init(){
  initTheme();await loadEmps();await loadPasses();updateConn();
}
init();
