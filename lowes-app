  if(chart){const tms=["تيم سوريا","تيم Lowes تركيا","تيم السوشال ميديا"];const tc=["#0d7377","#f59e0b","#8b5cf6"];
    chart.innerHTML=tms.map((t,i)=>{const tr=recs.filter(r=>r.team===t);const tp=tr.filter(r=>r.status===TL.in).length;const tot=allEmps.filter(e=>e.team===t).length||1;const pct=Math.round(tp/tot*100);
