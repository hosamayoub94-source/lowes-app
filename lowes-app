<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#FBF3E2">
<title>Lowe's Professional</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#0f1f3d;--teal:#0d7377;--cream:#fafaf8;--surface:#fff;
  --border:rgba(0,0,0,0.08);--text:#1a1a2e;--muted:#6b7280;
  --green:#10b981;--gbg:#ecfdf5;--gtxt:#065f46;
  --red:#ef4444;--rbg:#fef2f2;--rtxt:#991b1b;
  --blue:#3b82f6;--bbg:#eff6ff;--btxt:#1e40af;
  --amber:#f59e0b;--abg:#fffbeb;--atxt:#92400e;
  --purple:#8b5cf6;--pbg:#f5f3ff;--ptxt:#5b21b6;
}
[data-theme="dark"]{
  --cream:#0d1117;--surface:#161b22;--border:rgba(255,255,255,0.08);
  --text:#e6edf3;--muted:#8b949e;--gbg:#0d2818;--gtxt:#3fb950;
  --rbg:#2d1117;--rtxt:#f85149;--bbg:#0d1926;--btxt:#58a6ff;
  --abg:#271d04;--atxt:#e3b341;
}
[data-theme="dark"] .hero{background:linear-gradient(145deg,#0d1117,#161b22,#0d7377)}
[data-theme="dark"] .card,[data-theme="dark"] .stat-card,[data-theme="dark"] .log-entry,[data-theme="dark"] .req-item{background:#161b22}
[data-theme="dark"] select,[data-theme="dark"] input,[data-theme="dark"] textarea{background:#0d1117;color:#e6edf3;border-color:rgba(255,255,255,.1)}
[data-theme="dark"] .bottom-nav,[data-theme="dark"] .type-btn,[data-theme="dark"] .role-card,[data-theme="dark"] .login-card{background:#161b22}
[data-theme="dark"] .num-btn{background:#161b22;color:#e6edf3}
html,body{height:100%;background:var(--cream);font-family:'Tajawal',sans-serif;color:var(--text);-webkit-font-smoothing:antialiased}
.screen{display:none;min-height:100dvh;flex-direction:column}
.screen.active{display:flex}
.role-wrap{min-height:100vh;background:linear-gradient(145deg,var(--navy),#1b2a4a,var(--teal));display:flex;align-items:center;justify-content:center;padding:1.5rem}
.role-card{background:var(--surface);border-radius:24px;padding:2rem;width:100%;max-width:340px;text-align:center}
.r-logo{font-size:40px;margin-bottom:.5rem}
.r-title{font-size:20px;font-weight:700;color:var(--navy);margin-bottom:.25rem}
.r-sub{font-size:13px;color:var(--muted);margin-bottom:1.5rem}
.r-btns{display:flex;flex-direction:column;gap:10px}
.r-btn{padding:14px;border:none;border-radius:12px;font-size:15px;font-weight:700;font-family:'Tajawal',sans-serif;cursor:pointer;-webkit-tap-highlight-color:transparent}
.r-btn.emp{background:var(--gbg);color:var(--gtxt);border:1.5px solid var(--green)}
.r-btn.mgr{background:var(--bbg);color:var(--btxt);border:1.5px solid var(--blue)}
.r-btn.adm{background:var(--navy);color:#fff}
.login-wrap{min-height:100vh;background:linear-gradient(145deg,var(--navy),#1b2a4a,var(--teal));display:flex;align-items:center;justify-content:center;padding:1.5rem;display:none}
.login-card{background:var(--surface);border-radius:24px;padding:2rem;width:100%;max-width:340px;text-align:center}
.l-icon{font-size:36px;margin-bottom:.5rem}
.l-title{font-size:18px;font-weight:700;color:var(--navy);margin-bottom:.25rem}
.l-sub{font-size:13px;color:var(--muted);margin-bottom:1.25rem}
.l-inp{width:100%;padding:13px;border:1.5px solid var(--border);border-radius:10px;font-size:16px;font-family:'Tajawal',sans-serif;outline:none;text-align:center;color:var(--text);margin-bottom:10px;background:var(--cream)}
.l-inp:focus{border-color:var(--teal)}
.l-btn{width:100%;padding:14px;border:none;border-radius:10px;font-size:15px;font-weight:700;font-family:'Tajawal',sans-serif;cursor:pointer;color:#fff;background:var(--navy)}
.l-back{margin-top:10px;background:none;border:none;color:var(--muted);font-size:13px;cursor:pointer;font-family:'Tajawal',sans-serif}
.l-err{color:var(--red);font-size:13px;margin-top:6px;min-height:18px}
.hero{background:linear-gradient(145deg,var(--navy) 0%,#1b2a4a 60%,var(--teal) 100%);padding:2.25rem 1.5rem 1.25rem;position:relative;overflow:hidden}
.hero-logo{font-size:11px;letter-spacing:.15em;color:rgba(255,255,255,.5);text-transform:uppercase;margin-bottom:.4rem}
.hero-title{font-size:22px;font-weight:700;color:#fff;margin-bottom:.2rem}
.hero-date{font-size:12px;color:rgba(255,255,255,.6)}
.hero-time{font-size:34px;font-weight:300;color:#fff;letter-spacing:-1px;margin-top:.2rem}
.h-btns{position:absolute;top:1rem;left:1rem;display:flex;gap:6px}
.hbtn{background:rgba(255,255,255,.15);border:none;border-radius:50%;width:34px;height:34px;font-size:14px;cursor:pointer;color:#fff;display:flex;align-items:center;justify-content:center}
.body-area{padding:1rem;flex:1;overflow-y:auto}
.card{background:var(--surface);border-radius:14px;box-shadow:0 2px 10px rgba(0,0,0,.05);border:1px solid var(--border);padding:1.15rem;margin-bottom:.875rem}
.card-label{font-size:11px;font-weight:700;letter-spacing:.08em;color:var(--muted);text-transform:uppercase;margin-bottom:.6rem}
.sel-wrap{position:relative}
.sel-wrap::after{content:'▾';position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted);pointer-events:none;font-size:13px}
select,input[type="time"],input[type="text"],input[type="number"],input[type="email"],input[type="date"],input[type="password"]{width:100%;padding:11px 12px;border:1.5px solid var(--border);border-radius:10px;font-size:14px;font-family:'Tajawal',sans-serif;background:var(--cream);color:var(--text);outline:none}
select{padding-left:32px;appearance:none;-webkit-appearance:none}
select:focus,input:focus,textarea:focus{border-color:var(--teal)}
textarea{width:100%;padding:11px 12px;border:1.5px solid var(--border);border-radius:10px;font-size:14px;font-family:'Tajawal',sans-serif;background:var(--cream);color:var(--text);outline:none;resize:none}
.type-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.type-btn{padding:.9rem .5rem;border-radius:10px;border:1.5px solid var(--border);background:var(--cream);cursor:pointer;text-align:center;font-family:'Tajawal',sans-serif;-webkit-tap-highlight-color:transparent}
.type-btn .ti{font-size:22px;display:block;margin-bottom:4px}
.type-btn .tl{font-size:12px;font-weight:700;display:block}
.type-btn .ts{font-size:10px;color:var(--muted);display:block;margin-top:2px}
.sel-in{background:var(--gbg);border-color:var(--green)}.sel-in .tl{color:var(--gtxt)}
.sel-out{background:var(--rbg);border-color:var(--red)}.sel-out .tl{color:var(--rtxt)}
.sel-vac{background:var(--bbg);border-color:var(--blue)}.sel-vac .tl{color:var(--btxt)}
.sel-abs{background:var(--abg);border-color:var(--amber)}.sel-abs .tl{color:var(--atxt)}
.btn{padding:13px;background:var(--navy);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;font-family:'Tajawal',sans-serif;cursor:pointer;width:100%;-webkit-tap-highlight-color:transparent}
.btn:active{transform:scale(.98);opacity:.9}
.btn-teal{background:var(--teal)}.btn-green{background:var(--gbg);color:var(--gtxt);border:1px solid var(--green)}
.btn-muted{background:var(--cream);color:var(--muted);border:1.5px solid var(--border)}.btn-sm{padding:8px 14px;font-size:12px;width:auto}
.toast{position:fixed;top:1.25rem;left:50%;transform:translateX(-50%) translateY(-120px);background:var(--green);color:#fff;padding:11px 22px;border-radius:100px;font-size:13px;font-weight:700;z-index:999;transition:transform .3s cubic-bezier(.34,1.56,.64,1);white-space:nowrap;font-family:'Tajawal',sans-serif}
.toast.show{transform:translateX(-50%) translateY(0)}.toast.err{background:var(--red)}
.ann-bar{display:none;background:var(--navy);color:#fff;text-align:center;padding:10px 40px;font-size:13px;font-weight:500;position:relative;line-height:1.5}
.ann-bar.show{display:block}
.ann-close{position:absolute;left:12px;top:50%;transform:translateY(-50%);background:none;border:none;color:rgba(255,255,255,.6);font-size:18px;cursor:pointer}
.timer-card{display:none;background:linear-gradient(135deg,var(--teal),var(--navy));border-radius:14px;padding:1.15rem;margin-bottom:.875rem;color:#fff;text-align:center}
.timer-card.show{display:block}
.timer-disp{font-size:40px;font-weight:300;letter-spacing:2px;margin:.3rem 0}
.timer-lbl{font-size:11px;opacity:.7;letter-spacing:.08em;text-transform:uppercase}
.timer-emp{font-size:12px;opacity:.8;margin-bottom:.75rem}
.timer-out{background:rgba(255,255,255,.2);border:none;color:#fff;padding:9px 20px;border-radius:8px;font-size:13px;font-weight:700;font-family:'Tajawal',sans-serif;cursor:pointer}
.reminder{display:none;background:var(--abg);border:1.5px solid var(--amber);border-radius:10px;padding:10px 14px;margin-bottom:.875rem;font-size:13px;color:var(--atxt);font-weight:500}
.reminder.show{display:block}
.once-warn{display:none;background:var(--rbg);border:1.5px solid var(--red);border-radius:10px;padding:10px 14px;margin-bottom:.875rem;font-size:13px;color:var(--rtxt);font-weight:500}
.once-warn.show{display:block}
.urgent-bar{display:none;background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;padding:11px 14px;margin-bottom:.875rem;border-radius:12px;font-size:13px;font-weight:500;position:relative}
.urgent-bar.show{display:block}
.urg-close{position:absolute;top:8px;left:10px;background:none;border:none;color:rgba(255,255,255,.8);font-size:16px;cursor:pointer}
.log-entry{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;border:1px solid var(--border);background:var(--cream);margin-bottom:7px}
.log-av{width:36px;height:36px;border-radius:50%;color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0}
.log-info{flex:1;min-width:0}
.log-name{font-size:14px;font-weight:700}
.log-meta{font-size:11px;color:var(--muted);margin-top:1px;line-height:1.4}
.badge{font-size:10px;font-weight:700;padding:3px 9px;border-radius:100px;flex-shrink:0}
.b-in{background:var(--gbg);color:var(--gtxt)}.b-out{background:var(--rbg);color:var(--rtxt)}
.b-vac{background:var(--bbg);color:var(--btxt)}.b-abs{background:var(--abg);color:var(--atxt)}
.b-pend{background:var(--abg);color:var(--atxt)}.b-appr{background:var(--gbg);color:var(--gtxt)}.b-rej{background:var(--rbg);color:var(--rtxt)}
.hc{display:inline-block;background:var(--bbg);color:var(--btxt);font-size:10px;font-weight:700;padding:2px 7px;border-radius:20px;margin-right:3px}
.hc.warn{background:var(--abg);color:var(--atxt)}
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:1rem}
.stat-card{background:var(--surface);border-radius:10px;padding:.875rem;border:1px solid var(--border);text-align:center}
.stat-num{font-size:28px;font-weight:700}.stat-lbl{font-size:11px;color:var(--muted);font-weight:700;margin-top:2px}
.sg{color:var(--green)}.sr{color:var(--red)}.sb{color:var(--blue)}.sa{color:var(--amber)}.sp{color:var(--purple)}
.ftabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:.875rem}
.ftab{padding:5px 12px;border-radius:20px;border:1.5px solid var(--border);background:var(--surface);font-size:11px;font-weight:700;color:var(--muted);cursor:pointer;font-family:'Tajawal',sans-serif;-webkit-tap-highlight-color:transparent;white-space:nowrap}
.ftab.active{background:var(--navy);color:#fff;border-color:var(--navy)}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-top:.6rem}
.cal-hdr{text-align:center;font-size:10px;font-weight:700;color:var(--muted);padding:3px 0}
.cal-day{text-align:center;padding:5px 2px;border-radius:7px;font-size:12px;min-height:28px;display:flex;align-items:center;justify-content:center}
.cal-day.present{background:var(--gbg)}.cal-day.present span{color:var(--gtxt);font-weight:700}
.cal-day.absent{background:var(--rbg)}.cal-day.absent span{color:var(--rtxt);font-weight:700}
.cal-day.vacation{background:var(--bbg)}.cal-day.vacation span{color:var(--btxt);font-weight:700}
.cal-day.today{border:2px solid var(--teal)}.cal-day.empty{opacity:0}
.cal-nav{display:flex;justify-content:space-between;align-items:center}
.cal-nav button{background:none;border:1.5px solid var(--border);border-radius:8px;padding:4px 12px;font-size:16px;cursor:pointer;color:var(--text)}
.cal-nav-title{font-size:14px;font-weight:700;color:var(--text)}
.hol-item{display:flex;align-items:center;gap:12px;padding:10px 14px;background:var(--surface);border-radius:10px;border:1px solid var(--border);margin-bottom:7px}
.hol-icon{font-size:20px;flex-shrink:0;width:32px;text-align:center}
.hol-info{flex:1}.hol-name{font-size:14px;font-weight:700}.hol-date{font-size:12px;color:var(--muted);margin-top:2px}
.hol-days{font-size:12px;font-weight:700;padding:3px 10px;border-radius:20px;flex-shrink:0}
.next-hol{background:linear-gradient(135deg,var(--navy),var(--teal));border-radius:14px;padding:1.15rem;margin-bottom:1rem;color:#fff;text-align:center}
.next-hol-lbl{font-size:11px;opacity:.7;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.3rem}
.next-hol-name{font-size:18px;font-weight:700;margin-bottom:.25rem}
.next-hol-days{font-size:32px;font-weight:300;margin-top:.5rem}
.prof-av{width:70px;height:70px;border-radius:50%;background:var(--teal);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:700;margin:0 auto .75rem}
.msg-item{background:var(--surface);border-radius:10px;border:1px solid var(--border);padding:10px;margin-bottom:7px}
.msg-item.unread{border-color:var(--amber);background:var(--abg)}
.msg-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px}
.msg-type{font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px}
.m-urgent{background:var(--rbg);color:var(--rtxt)}.m-personal{background:var(--bbg);color:var(--btxt)}
.msg-date{font-size:11px;color:var(--muted)}.msg-text{font-size:13px;line-height:1.6}
.msg-tpls{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
.msg-tpl{font-size:11px;padding:4px 10px;border-radius:20px;border:1px solid var(--border);background:var(--surface);cursor:pointer;font-family:'Tajawal',sans-serif;color:var(--text)}
.req-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;border:1px solid var(--border);background:var(--surface);margin-bottom:7px}
.req-info{flex:1}.req-name{font-size:14px;font-weight:700}.req-meta{font-size:11px;color:var(--muted);margin-top:2px}
.req-actions{display:flex;gap:6px}
.req-appr,.req-rej{border-radius:8px;padding:5px 12px;font-size:12px;font-weight:700;cursor:pointer;font-family:'Tajawal',sans-serif;border:none}
.req-appr{background:var(--gbg);color:var(--gtxt)}.req-rej{background:var(--rbg);color:var(--rtxt)}
.stars{display:flex;gap:8px;justify-content:center;margin:10px 0}
.star{font-size:28px;cursor:pointer;opacity:.3;transition:opacity .15s}.star.active{opacity:1}
.pin-dots{display:flex;gap:10px;justify-content:center;margin:1rem 0}
.pin-dot{width:14px;height:14px;border-radius:50%;border:2px solid var(--border);background:var(--cream);transition:all .2s}
.pin-dot.filled{background:var(--navy);border-color:var(--navy)}
.pin-dot.error{background:var(--red);border-color:var(--red)}
.pin-dot.ok{background:var(--green);border-color:var(--green)}
.numpad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:1rem}
.num-btn{padding:.9rem;border-radius:12px;border:1.5px solid var(--border);background:var(--surface);font-size:20px;font-weight:700;font-family:'Tajawal',sans-serif;color:var(--text);cursor:pointer;-webkit-tap-highlight-color:transparent}
.num-btn:active{background:var(--navy);color:#fff;transform:scale(.95)}
.pin-name{font-size:16px;font-weight:700;text-align:center;margin-bottom:.25rem}
.pin-hint{font-size:12px;color:var(--muted);text-align:center}
.pin-err{font-size:13px;color:var(--rtxt);text-align:center;margin-top:.5rem;min-height:18px}
.chart-bar-wrap{margin-bottom:.5rem}
.chart-bar-label{display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px}
.chart-bar-bg{background:var(--border);border-radius:4px;height:8px;overflow:hidden}
.chart-bar-fill{height:8px;border-radius:4px;transition:width .5s}
.payroll-total-box{background:var(--gbg);border-radius:10px;padding:12px;display:flex;justify-content:space-between;align-items:center;margin:10px 0}
.bonus-item{display:flex;gap:8px;margin-bottom:8px;align-items:center}
.bonus-remove{background:var(--rbg);color:var(--rtxt);border:none;border-radius:6px;padding:6px 10px;cursor:pointer;font-size:12px;flex-shrink:0}
.comm-row{display:flex;gap:8px}.comm-row select{width:110px;flex-shrink:0}
.tbl-wrap{background:var(--surface);border-radius:14px;border:1px solid var(--border);overflow:hidden;margin-bottom:1rem}
table{width:100%;border-collapse:collapse;min-width:500px}
.tbl-scroll{overflow-x:auto}
thead tr{background:var(--cream)}
th{padding:9px 12px;text-align:right;font-size:11px;font-weight:700;color:var(--muted);white-space:nowrap}
td{padding:9px 12px;font-size:13px;border-top:1px solid var(--border)}
tr:hover td{background:rgba(0,0,0,.02)}
.f-group{margin-bottom:10px}
.f-group label{display:block;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.conn-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);margin-left:4px;vertical-align:middle}
.save-msg{font-size:12px;text-align:center;margin-top:6px;min-height:18px}
.empty{text-align:center;padding:2rem 1rem;color:var(--muted)}
.empty .ei{font-size:38px;margin-bottom:.5rem}.empty p{font-size:13px}
.loading{text-align:center;padding:1.5rem;color:var(--muted);font-size:13px}
.copy-btn{width:100%;padding:12px;background:var(--surface);color:var(--navy);border:1.5px solid var(--navy);border-radius:10px;font-size:13px;font-weight:700;font-family:'Tajawal',sans-serif;cursor:pointer;margin-top:4px}
.bottom-nav{display:flex;background:var(--surface);border-top:1px solid var(--border);padding:.5rem 0 env(safe-area-inset-bottom,.5rem)}
.nav-btn{flex:1;padding:7px 0 4px;background:none;border:none;cursor:pointer;font-family:'Tajawal',sans-serif;font-size:9px;font-weight:700;color:var(--muted);display:flex;flex-direction:column;align-items:center;gap:3px;-webkit-tap-highlight-color:transparent}
.nav-btn .ni{font-size:18px}
.nav-btn.active{color:var(--teal)}
.unread-dot{width:8px;height:8px;border-radius:50%;background:var(--amber);display:inline-block;margin-right:3px;vertical-align:middle}
</style>
</head>
<body>
<div class="toast" id="toast"></div>

<!-- ROLE SELECTION -->
<div class="role-wrap" id="role-wrap">
  <div class="role-card">
    <div class="r-logo">🌹</div>
    <div class="r-title">Lowe's Professional</div>
    <div class="r-sub">نظام متكامل للحضور والإدارة</div>
    <div class="r-btns">
      <button class="r-btn emp" onclick="enterEmp()">👤 دخول كموظف</button>
      <button class="r-btn mgr" onclick="showLogin('manager')">👩‍💼 دخول كمدير</button>
      <button class="r-btn adm" onclick="showLogin('admin')">🔑 دخول كأدمن</button>
    </div>
  </div>
</div>

<!-- LOGIN -->
<div class="login-wrap" id="login-wrap">
  <div class="login-card">
    <div class="l-icon" id="l-icon">🔑</div>
    <div class="l-title" id="l-title">كلمة السر</div>
    <div class="l-sub" id="l-sub">أدخل كلمة السر للمتابعة</div>
    <input type="password" id="l-pass" class="l-inp" placeholder="••••••••" onkeydown="if(event.key==='Enter')doLogin()">
    <button class="l-btn" onclick="doLogin()">دخول</button>
    <div class="l-err" id="l-err"></div>
    <button class="l-back" onclick="backRoles()">← رجوع</button>
  </div>
