  const bon=document.getElementById("bon_"+en);const bonuses=[];bon?.querySelectorAll(".bonus-item").forEach(item=>{const ins=item.querySelectorAll("input");const name=ins[0]?.value?.trim();const amount=parseFloat(ins[1]?.value||0)||0;if(name||amount)bonuses.push({name:name||"إضافة",amount});});
